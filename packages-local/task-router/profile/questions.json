{
  "version": 1,
  "note": "Small discriminative eval set for capability profiling. Each question has a deterministic grader; the profiler runs these through the magpie gateway per candidate model.",
  "categories": [
    "code",
    "reasoning",
    "chinese",
    "general"
  ],
  "questions": [
    {
      "id": "code-fib",
      "category": "code",
      "prompt": "用 Python 写一个函数 f(n)，返回第 n 个斐波那契数（f(0)=0, f(1)=1）。给出代码，并在最后单独一行输出 f(10) 的值，格式：f(10) = <数字>",
      "grader": {
        "type": "contains_all",
        "values": [
          "def f",
          "f(10) = 55"
        ]
      }
    },
    {
      "id": "code-sql",
      "category": "code",
      "prompt": "数据库表 users(id, name, age)。写一条 SQL 统计年龄大于 18 的用户数量。只输出 SQL。",
      "grader": {
        "type": "contains_all",
        "values": [
          "select",
          "count",
          "where"
        ]
      }
    },
    {
      "id": "code-bug",
      "category": "code",
      "prompt": "这段 Python 代码运行时会出什么错？一个词回答错在哪个元素上即可：\nfor i in range(len(arr)): arr[i+1] = arr[i]",
      "grader": {
        "type": "contains_any",
        "values": [
          "indexerror",
          "越界",
          "out of range",
          "i+1",
          "最后一个"
        ]
      }
    },
    {
      "id": "code-regex",
      "category": "code",
      "prompt": "写一个正则表达式，匹配中国大陆手机号（1 开头的 11 位数字，第二位是 3-9）。只输出正则本身。",
      "grader": {
        "type": "contains_all",
        "values": [
          "3-9",
          "9}"
        ]
      }
    },
    {
      "id": "code-git",
      "category": "code",
      "prompt": "Git：撤销最近一次提交、但把改动保留在工作区（不丢代码），用什么命令？写出完整命令。",
      "grader": {
        "type": "contains_any",
        "values": [
          "reset --soft",
          "reset --mixed",
          "reset head^",
          "reset head~1"
        ]
      }
    },
    {
      "id": "code-typeof",
      "category": "code",
      "prompt": "JavaScript 里 typeof null 的返回值是什么？只回答这个返回值。",
      "grader": {
        "type": "exact",
        "value": "object"
      }
    },
    {
      "id": "reason-lotus",
      "category": "reasoning",
      "prompt": "池塘里的荷花每天覆盖面积翻一番，48 天正好铺满整个池塘。问第几天铺满一半？只回答数字。",
      "grader": {
        "type": "exact",
        "value": "47"
      }
    },
    {
      "id": "reason-cats",
      "category": "reasoning",
      "prompt": "3 只猫 3 分钟能抓 3 只老鼠。照此效率，9 只猫抓 9 只老鼠需要几分钟？只回答数字。",
      "grader": {
        "type": "regex",
        "values": [
          "(^|[^0-9.])3($|[^0-9.])"
        ]
      }
    },
    {
      "id": "reason-paradox",
      "category": "reasoning",
      "prompt": "小明说：'我正在说的这句话是假的。' 这句话是真还是假？",
      "grader": {
        "type": "contains_any",
        "values": [
          "悖论",
          "无法判定",
          "不能判定",
          "矛盾",
          "既不真也不假",
          "paradox",
          "self-referential",
          "自指"
        ]
      }
    },
    {
      "id": "reason-price",
      "category": "reasoning",
      "prompt": "一件衣服先涨价 10%，再降价 10%，现价是 99 元。原价是多少元？只回答数字。",
      "grader": {
        "type": "exact",
        "value": "100"
      }
    },
    {
      "id": "reason-clock",
      "category": "reasoning",
      "prompt": "3 点 15 分时，钟表时针与分针的夹角是多少度？只回答数字。",
      "grader": {
        "type": "exact",
        "value": "7.5"
      }
    },
    {
      "id": "reason-queue",
      "category": "reasoning",
      "prompt": "5 个人排成一排照相，甲不能站两端，且乙必须紧挨在甲的右边。共有多少种排法？只回答数字。",
      "grader": {
        "type": "exact",
        "value": "12"
      }
    },
